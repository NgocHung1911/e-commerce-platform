{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2563eb"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#4f46e5"
				},
				{
					"name": "Dark",
